# Copy these values into Streamlit Community Cloud → App settings → Secrets.
# Do not rename this file to secrets.toml and commit it with real values.

[auth]
redirect_uri = "https://YOUR-STREAMLIT-APP.streamlit.app/oauth2callback"
cookie_secret = "GENERATE_A_LONG_RANDOM_SECRET_AND_KEEP_IT_PRIVATE"

[auth.auth0]
client_id = "YOUR_AUTH0_APPLICATION_CLIENT_ID"
client_secret = "YOUR_AUTH0_APPLICATION_CLIENT_SECRET"
server_metadata_url = "https://YOUR_AUTH0_TENANT_REGION.auth0.com/.well-known/openid-configuration"

# Optional: enables the full SQLite export in Settings only for this signed-in email.
# Use the same email address used for the Auth0 LunaTicK owner account.
[backup]
owner_email = "YOUR_AUTH0_OWNER_EMAIL@example.com"

# Phase A storage switch. Leave as "sqlite" until the Supabase schema is applied
# and Phase C profile migration has passed its reconciliation checks.
[storage]
data_backend = "sqlite"

# Add only when preparing the server-side Supabase integration. Never expose the
# service role key to browser code or commit it to GitHub.
[supabase]
url = "https://YOUR_PROJECT_REF.supabase.co"
service_role_key = "YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"
