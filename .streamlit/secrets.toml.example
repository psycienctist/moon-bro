# Copy these values into Streamlit Community Cloud → App settings → Secrets.
# Do not rename this file to secrets.toml and commit it with real values.

[auth]
redirect_uri = "https://YOUR-STREAMLIT-APP.streamlit.app/oauth2callback"
cookie_secret = "GENERATE_A_LONG_RANDOM_SECRET_AND_KEEP_IT_PRIVATE"

[auth.auth0]
client_id = "YOUR_AUTH0_APPLICATION_CLIENT_ID"
client_secret = "YOUR_AUTH0_APPLICATION_CLIENT_SECRET"
server_metadata_url = "https://YOUR_AUTH0_TENANT_REGION.auth0.com/.well-known/openid-configuration"
